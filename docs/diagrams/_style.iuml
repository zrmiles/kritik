' Общий стиль диаграмм «Критика»: подключается через !include _style.iuml
!pragma layout smetana
skinparam defaultFontName "Arial"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 8
skinparam dpi 150
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A3F35
skinparam ArrowFontColor #4A3F35
skinparam ArrowFontSize 12
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #C9A227
skinparam ActorBorderColor #7A2E2E
skinparam ActorBackgroundColor #F6E7E7
skinparam ParticipantBorderColor #4A3F35
skinparam ParticipantBackgroundColor #F4EFE6
skinparam DatabaseBorderColor #4A3F35
skinparam DatabaseBackgroundColor #E9E2D3
skinparam UsecaseBorderColor #4A3F35
skinparam UsecaseBackgroundColor #F4EFE6
skinparam RectangleBorderColor #4A3F35
skinparam ComponentBorderColor #4A3F35
skinparam ComponentBackgroundColor #F4EFE6
skinparam ClassBorderColor #4A3F35
skinparam ClassBackgroundColor #F9F6F0
skinparam ClassHeaderBackgroundColor #E9E2D3
skinparam StateBorderColor #4A3F35
skinparam StateBackgroundColor #F4EFE6
skinparam ActivityBorderColor #4A3F35
skinparam ActivityBackgroundColor #F4EFE6
skinparam ActivityDiamondBorderColor #4A3F35
skinparam ActivityDiamondBackgroundColor #E9E2D3
skinparam SequenceLifeLineBorderColor #8C8173
skinparam SequenceGroupBorderColor #8C8173
skinparam SequenceGroupBackgroundColor #F4EFE6
