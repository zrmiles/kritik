DJANGO_SECRET_KEY=change-me-for-local-development-at-least-32-chars
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Для доступа по домену/IP добавьте адрес с протоколом, например https://kritik.example.ru
DJANGO_CSRF_TRUSTED_ORIGINS=
JWT_COOKIE_SECURE=false

# PostgreSQL. Если POSTGRES_DB не задан, используется SQLite (db.sqlite3).
POSTGRES_DB=
POSTGRES_USER=kritik
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Ключ RAWG: зарегистрируйтесь на https://rawg.io/apidocs. Нужен только для импорта игр.
RAWG_API_KEY=
